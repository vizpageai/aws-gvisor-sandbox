name            = "gvisor-eks"
region          = "us-east-1"
cluster_version = "1.36"
ubuntu_release  = "24.04"

# Replace this documentation-only address with your public IPv4 address /32,
# or use scripts/deploy.ps1 to detect it automatically.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
high_availability_nat_gateway        = true

gvisor_node_instance_types = ["m6i.large"]
gvisor_desired_size        = 1
gvisor_min_size            = 1
gvisor_max_size            = 4

gvisor_release_channel = "release"
gvisor_release_version = "20260427.0"
enable_smoke_test      = true

enable_gpu_node_group   = true
gpu_node_instance_types = ["g6.xlarge"]
gpu_desired_size        = 0
gpu_min_size            = 0
gpu_max_size            = 1
gpu_accelerator_label   = "nvidia-l4"
gpu_operator_chart_version = "v26.3.3"

enable_cluster_autoscaler       = true
cluster_autoscaler_chart_version = "9.59.0"
cluster_autoscaler_image_tag     = "v1.36.1"

enable_sandbox_s3             = true
sandbox_s3_bucket_name        = null
enable_ebs_csi                = true
sandbox_block_storage_class   = "gp3"
sandbox_namespace             = "default"
sandbox_service_account_name  = "gvisor-sandbox"

tags = {
  Environment = "dev"
}
